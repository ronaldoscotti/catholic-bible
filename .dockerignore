# Anything git hides, Docker hides too. These two files drift apart silently,
# and COPY . /app is what turns the drift into a leak.
CONTEXT.local.md
*.local.md
.env
.env.*
!.env.example

.git/
.github/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
/scratch/
/tmp/
# The image builds its own. A laptop built one would be copied over it.
*.db
*.sqlite3
*.sqlite3-journal
.DS_Store

# scratch from make verify-export
.verify/

# The published artifacts. 48 MB of static files served from a CDN, which no
# code path under src/ opens, and COPY . /app would bake them into both stages.
/data/
/.data-build/
/.artifacts-check/
